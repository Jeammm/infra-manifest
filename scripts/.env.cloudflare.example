# Cloudflare API credentials
# Required API token permissions:
#   Account > Cloudflare Tunnel > Edit
#   Zone > DNS > Edit
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# Tunnel name (any descriptive label — the controller creates it automatically)
CF_TUNNEL_NAME=k3s-homelab

# Your domain (for reference — actual hostnames are set in Ingress resources)
CF_DOMAIN=example.com

# Zone ID (used by teardown.sh to clean up DNS records)
CF_ZONE_ID=your-cloudflare-zone-id
